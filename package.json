{
  "name": "TrackaExpense",
  "version": "1.3.5",
  "private": true,
  "keywords": [
    "expense tracker",
    "budget planner",
    "personal finance",
    "bill splitter",
    "money manager",
    "savings goals",
    "receipt scanner",
    "ad-free",
    "split expenses",
    "expense log",
    "income tracker",
    "finance app"
  ],
  "scripts": {
    "android": "react-native run-android",
    "android:release": "react-native run-android --variant=release",
    "ios": "react-native run-ios",
    "ios:release": "react-native run-ios --configuration Release",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:android:bundle": "cd android && ./gradlew bundleRelease",
    "build:clean": "cd android && ./gradlew clean",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "check:ratchet": "node scripts/check-ratchet.mjs",
    "prepare": "husky",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "test": "jest",
    "emulators": "firebase emulators:start --only firestore,storage --project demo-trackaexpense-rules",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-trackaexpense-rules \"yarn node --test firebase/tests/rules.test.mjs\"",
    "postinstall": "patch-package",
    "version:bump": "node scripts/bump-version.js",
    "release:ios": "revopush release-react Tracka-ios ios -d Production",
    "release:android": "revopush release-react Tracka-android android -d Production",
    "release:all": "yarn release:ios && yarn release:android"
  },
  "dependencies": {
    "@invertase/react-native-apple-authentication": "^2.4.1",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-firebase/analytics": "^21.14.0",
    "@react-native-firebase/app": "^21.6.1",
    "@react-native-firebase/auth": "^21.6.1",
    "@react-native-firebase/crashlytics": "^21.14.0",
    "@react-native-firebase/firestore": "^21.6.1",
    "@react-native-firebase/messaging": "^21.6.1",
    "@react-native-firebase/perf": "^21.14.0",
    "@react-native-firebase/remote-config": "^21.14.0",
    "@react-native-firebase/storage": "^21.6.1",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-native/gradle-plugin": "0.77.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/stack": "^7.1.0",
    "@revopush/react-native-code-push": "^1.5.1",
    "@sentry/react-native": "8.34.0",
    "mixpanel-react-native": "4.1.0",
    "moment": "^2.30.1",
    "react": "18.3.1",
    "react-native": "0.77.0",
    "react-native-device-info": "10.3.0",
    "react-native-dotenv": "^3.4.11",
    "react-native-dropdown-picker": "^5.4.6",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "2.22.1",
    "react-native-gifted-charts": "^1.4.47",
    "react-native-image-picker": "^7.2.3",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-onboarding-swiper": "^1.3.0",
    "react-native-onesignal": "5.4.3",
    "react-native-paper": "^5.12.5",
    "react-native-paper-dates": "^0.22.28",
    "react-native-safe-area-context": "5.0.0",
    "react-native-screens": "4.3.0",
    "react-native-share": "^12.2.0",
    "react-native-svg": "15.13.0",
    "react-native-user-avatar": "^1.0.8",
    "react-native-vector-icons": "^10.2.0",
    "sp-react-native-in-app-updates": "^1.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@react-native-community/cli": "16.0.2",
    "@react-native-community/cli-platform-android": "16.0.2",
    "@react-native-community/cli-platform-ios": "16.0.2",
    "@react-native/babel-preset": "0.77.0",
    "@react-native/eslint-config": "0.77.0",
    "@react-native/metro-config": "0.77.0",
    "@react-native/typescript-config": "0.77.0",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.19.0",
    "firebase": "^13.2.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^17.6.0",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
