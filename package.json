{
  "name": "TrackaExpense",
  "version": "1.6.0",
  "private": true,
  "keywords": [
    "expense tracker",
    "budget planner",
    "personal finance",
    "bill splitter",
    "money manager",
    "savings goals",
    "receipt scanner",
    "ad-free",
    "split expenses",
    "expense log",
    "income tracker",
    "finance app"
  ],
  "scripts": {
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:android:bundle": "cd android && ./gradlew bundleRelease",
    "build:clean": "cd android && ./gradlew clean",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "check:ratchet": "node scripts/check-ratchet.mjs",
    "prepare": "husky",
    "start": "expo start",
    "start:reset": "expo start --clear",
    "test": "jest",
    "emulators": "firebase emulators:start --only firestore,storage --project demo-trackaexpense-rules",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-trackaexpense-rules \"yarn node --test firebase/tests/rules.test.mjs\"",
    "postinstall": "patch-package",
    "version:bump": "node scripts/bump-version.js",
    "release:android:local": "bash scripts/local-release.sh",
    "functions:build": "yarn --cwd functions build",
    "test:functions": "yarn --cwd functions test",
    "test:backfill": "yarn --cwd functions build && functions/node_modules/.bin/firebase emulators:exec --only firestore --project demo-trackaexpense-backfill \"$(command -v node) functions/test/backfill.emulator.test.mjs\"",
    "test:push": "yarn --cwd functions build && functions/node_modules/.bin/firebase emulators:exec --only functions,firestore,auth --project demo-trackaexpense-push \"$(command -v node) functions/test/push.emulator.test.mjs\"",
    "test:invitation": "yarn --cwd functions build && functions/node_modules/.bin/firebase emulators:exec --only functions,firestore,auth --project demo-trackaexpense-invitation \"$(command -v node) functions/test/invitation.emulator.test.mjs\"",
    "test:settlement": "yarn --cwd functions build && functions/node_modules/.bin/firebase emulators:exec --only functions,firestore,auth --project demo-trackaexpense-settlement \"$(command -v node) functions/test/settlement.emulator.test.mjs\"",
    "test:triggers": "yarn --cwd functions build && functions/node_modules/.bin/firebase emulators:exec --only functions,firestore,auth --project demo-trackaexpense-functions \"$(command -v node) functions/test/triggers.emulator.test.mjs\""
  },
  "dependencies": {
    "@expo/log-box": "^58.0.15",
    "@expo/metro-runtime": "~58.0.17",
    "@invertase/react-native-apple-authentication": "^2.4.1",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-firebase/app": "27.1.0",
    "@react-native-firebase/auth": "27.1.0",
    "@react-native-firebase/firestore": "27.1.0",
    "@react-native-firebase/functions": "27.1.0",
    "@react-native-firebase/messaging": "27.1.0",
    "@react-native-firebase/perf": "27.1.0",
    "@react-native-firebase/remote-config": "27.1.0",
    "@react-native-firebase/storage": "27.1.0",
    "@react-native-google-signin/google-signin": "17.0.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@sentry/react-native": "~8.28.0",
    "@shopify/react-native-skia": "2.14.0",
    "@tanstack/query-sync-storage-persister": "^5.107.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.20",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.13",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "jest-expo": "~58.0.14",
    "lucide-react-native": "^1.72.0",
    "mixpanel-react-native": "4.1.0",
    "moment": "^2.30.1",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-gifted-charts": "^1.4.47",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-onesignal": "5.5.17",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-share": "^12.2.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "sp-react-native-in-app-updates": "^1.5.0",
    "victory-native": "42.0.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@react-native-community/cli": "16.0.2",
    "@react-native-community/cli-platform-android": "16.0.2",
    "@react-native-community/cli-platform-ios": "16.0.2",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.19.0",
    "eslint-plugin-ft-flow": "^2.0.1",
    "firebase": "^13.2.0",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "lint-staged": "^17.6.0",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "3.4.17",
    "typescript": "~6.0.3"
  },
  "resolutions": {
    "**/react-native-device-info": "10.3.0",
    "**/firebase": "13.2.0"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "main": "index.js"
}
