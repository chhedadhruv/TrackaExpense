{
  "expo": {
    "name": "TrackaExpense",
    "slug": "trackaexpense",
    "description": "TrackaExpense is the all-in-one, ad-free personal finance app. Track daily expenses, plan monthly budgets, split bills with friends, capture receipts, and reach savings goals, with real-time cloud sync across Android and iOS.",
    "version": "1.5.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": ["trackaexpense", "com.dhruvchheda.trackaexpense"],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.dhruvchheda.trackaexpense",
      "buildNumber": "26111309",
      "supportsTablet": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "development",
        "com.apple.developer.applesignin": ["Default"]
      },
      "infoPlist": {
        "UIBackgroundModes": ["fetch", "remote-notification"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.trackaexpense",
      "versionCode": 26111309,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-foreground.png",
        "backgroundImage": "./assets/icon-background.png",
        "monochromeImage": "./assets/icon-monochrome.png",
        "backgroundColor": "#2b3787"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACCESS_ADSERVICES_AD_ID",
        "android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
      ]
    },
    "plugins": [
      "./plugins/with-update-channel",
      "./plugins/with-gradle-memory",
      "./plugins/with-notification-icon",
      "./plugins/with-firebase-gradle-versions",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/perf",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          },
          "android": {
            "usesCleartextTraffic": false,
            "kotlinVersion": "2.4.0",
            "buildArchs": ["armeabi-v7a", "arm64-v8a", "x86_64"],
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.790161106297-n9vtbq5iis8bi7smro05goqpbtge7hge"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "dhruv-chheda",
          "project": "trackaexpense",
          "experimental_android": {
            "enableAndroidGradlePlugin": true,
            "includeProguardMapping": true,
            "autoUploadProguardMapping": true,
            "uploadNativeSymbols": false,
            "autoUploadNativeSymbols": false,
            "includeNativeSources": false
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "This app uses the camera to capture receipt photos for your transactions.",
          "photosPermission": "This app needs access to your photo library to let you choose receipt images."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Kufam-SemiBoldItalic.ttf",
            "./assets/fonts/Lato-Bold.ttf",
            "./assets/fonts/Lato-BoldItalic.ttf",
            "./assets/fonts/Lato-Italic.ttf",
            "./assets/fonts/Lato-Regular.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 288,
          "backgroundColor": "#4553b3"
        }
      ],
      "expo-router",
      "./plugins/with-release-signing"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/9656a4c0-2877-41af-afae-7f7b366a1479",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "9656a4c0-2877-41af-afae-7f7b366a1479"
      }
    },
    "owner": "chhedadhruv"
  }
}
