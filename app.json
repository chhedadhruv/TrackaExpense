{
  "expo": {
    "name": "TrackaExpense",
    "slug": "trackaexpense",
    "description": "TrackaExpense is the all-in-one, ad-free personal finance app. Track daily expenses, plan monthly budgets, split bills with friends, capture receipts, and reach savings goals, with real-time cloud sync across Android and iOS.",
    "version": "1.3.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": [
      "trackaexpense",
      "com.dhruvchheda.trackaexpense"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.dhruvchheda.trackaexpense",
      "buildNumber": "26062421",
      "supportsTablet": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "development",
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.trackaexpense",
      "versionCode": 26062421,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#050A30"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "./plugins/with-firebase-gradle-versions",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/crashlytics",
      "@react-native-firebase/perf",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "usesCleartextTraffic": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.790161106297-n9vtbq5iis8bi7smro05goqpbtge7hge"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "dhruv-chheda",
          "project": "trackaexpense"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "This app uses the camera to capture receipt photos for your transactions.",
          "photosPermission": "This app needs access to your photo library to let you choose receipt images."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Kufam-SemiBoldItalic.ttf",
            "./assets/fonts/Lato-Bold.ttf",
            "./assets/fonts/Lato-BoldItalic.ttf",
            "./assets/fonts/Lato-Italic.ttf",
            "./assets/fonts/Lato-Regular.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "backgroundColor": "#050A30"
        }
      ],
      "./plugins/with-release-signing"
    ]
  }
}
